{
  "name": "@kvidzibo/pi-web-access",
  "version": "0.2.2",
  "description": "MCP server and Pi package: keyless web search, URL fetch, and cached content",
  "author": "Tomas Rackauskas",
  "keywords": [
    "pi-package",
    "mcp",
    "web-search"
  ],
  "bin": {
    "pi-web-access-mcp": "./mcp/cli.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvidzibo/pi-web-access.git"
  },
  "homepage": "https://github.com/kvidzibo/pi-web-access#readme",
  "bugs": {
    "url": "https://github.com/kvidzibo/pi-web-access/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "esbuild mcp/server.mjs --bundle --platform=node --format=esm --external:@modelcontextprotocol/sdk --external:@mozilla/readability --external:linkedom --external:turndown --outfile=dist-mcp/server.mjs",
    "prepack": "npm run build",
    "test": "npm run test:unit && npm run test:mcp && npm run test:load",
    "test:mcp": "npm run build && node --test --experimental-strip-types tests/mcp/*.test.ts",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:load": "node --test --experimental-strip-types tests/load/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.0",
    "turndown": "^7.2.0"
  },
  "files": [
    "index.ts",
    "src/",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "README.md",
    "mcp/",
    "dist-mcp/"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typebox": "^1.4.1"
  }
}
